{
  "expo": {
    "name": "Carbix",
    "slug": "carbix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carbix",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F0EEE7",
    "ios": {
      "bundleIdentifier": "com.solyapps.carbix",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.solyapps.carbix",
      "adaptiveIcon": {
        "backgroundColor": "#D8402F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F0EEE7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Carbix uses the camera so you can photograph cars you spot. A photo is sent to our server only when you tap Catch, to identify the make and model.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Carbix reads a photo you choose so it can identify the car in it."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Carbix can pin where you spotted a car on your own map. Your location stays on this phone."
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-status-bar",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "solomonsasson",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e8205d95-5bed-46b2-bab9-a5e1bcfdee83"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e8205d95-5bed-46b2-bab9-a5e1bcfdee83"
    }
  }
}
